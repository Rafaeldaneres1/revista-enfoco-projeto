# MongoDB Atlas — NÃO use localhost em produção
# Crie usuário e ative IP Whitelist no atlas.mongodb.com
MONGO_URL=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=revista_enfoco

# Domínio do frontend — NUNCA use * em produção
CORS_ORIGINS=https://seudominio.com.br

# Gere com: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=

# Domínio do backend no Render (sem https://)
ALLOWED_HOSTS=seu-backend.onrender.com,localhost

# Pasta de uploads locais (ignorar se usar Cloudinary ou Vercel Blob)
UPLOADS_DIR=/var/data/uploads

# Cloudinary — deixe vazio se não usar
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob — deixe vazio se não usar
BLOB_READ_WRITE_TOKEN=
